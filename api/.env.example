# Banco de Dados (PostgreSQL + Psycopg3)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sgaa_dev

# Configurações Gerais da API
# Mínimo de 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres

# Origens permitidas para o front web (separadas por vírgula)
CORS_ORIGINS=http://localhost:8081

# Autenticação (opcionais; valores padrão abaixo)
# JWT_EXPIRA_DIAS=30
# CODIGO_EXPIRA_MINUTOS=15
# CONVITE_EXPIRA_HORAS=72

# E-mail: "console" apenas loga a mensagem; "smtp" envia de verdade
EMAIL_BACKEND=console
# EMAIL_REMETENTE=SGAA <nao-responda@seudominio.com>
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Push: "console" apenas loga a notificação; "expo" envia pelo Expo Push Service
PUSH_BACKEND=console
# Access token do Expo, se o projeto exigir envio com segurança reforçada
# EXPO_ACCESS_TOKEN=

# Deploy na AWS Lambda: o template define AMBIENTE e SSM_PREFIXO, e os
# valores acima vêm do Parameter Store. CLOUDFRONT_SEGREDO, quando definido,
# faz a API recusar com 403 o que não passou pelo CloudFront. Localmente,
# deixe os três sem definir.
# AMBIENTE=
# SSM_PREFIXO=
# CLOUDFRONT_SEGREDO=

# Arquivos: "desligado" responde 503 nas rotas; "google" guarda no Google Drive.
# Ver docs/google_drive.md.
DRIVE_BACKEND=desligado
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Uma pasta por ambiente.
# GOOGLE_DRIVE_PASTA_ID=

# Observabilidade (opcional): token de escrita do Logfire.
# Sem ele nada é enviado; em desenvolvimento local, deixe comentado.
# LOGFIRE_TOKEN=
