# Banco de Dados (PostgreSQL + Psycopg3)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sgaa_dev

# Configurações Gerais da API
# Mínimo de 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres

# Origens permitidas para o front web (separadas por vírgula)
CORS_ORIGINS=http://localhost:8081

# Autenticação (opcionais; valores padrão abaixo)
# JWT_EXPIRA_DIAS=30
# CODIGO_EXPIRA_MINUTOS=15
# CONVITE_EXPIRA_HORAS=72

# E-mail: "console" apenas loga a mensagem; "smtp" envia de verdade
EMAIL_BACKEND=console
# EMAIL_REMETENTE=SGAA <nao-responda@seudominio.com>
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
