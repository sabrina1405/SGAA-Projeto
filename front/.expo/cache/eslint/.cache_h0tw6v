 for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\sabri\\sgaa-projeto\\front\\src\\hooks\\use-color-scheme.web.ts:11:5\n   9 |\n  10 |   useEffect(() => {\n> 11 |     setHasHydrated(true);\n     |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  12 |   }, []);\n  13 |\n  14 |   const colorScheme = useRNColorScheme();",{"messageId":"195","data":"196","fix":"197","desc":"198"},{"messageId":"199","data":"200","fix":"201","desc":"202"},{"messageId":"195","data":"203","fix":"204","desc":"198"},{"messageId":"195","data":"205","fix":"206","desc":"198"},{"messageId":"199","data":"207","fix":"208","desc":"209"},{"messageId":"199","data":"210","fix":"211","desc":"212"},{"messageId":"195","data":"213","fix":"214","desc":"198"},{"messageId":"195","data":"215","fix":"216","desc":"198"},{"messageId":"195","data":"217","fix":"218","desc":"198"},{"messageId":"199","data":"219","fix":"220","desc":"221"},{"messageId":"199","data":"222","fix":"223","desc":"224"},"removeUnusedImportDeclaration",{"varName":"225"},{"range":"226","text":"227"},"Remove unused import declaration.","removeUnusedVar",{"varName":"228"},{"range":"229","text":"227"},"Remove unused variable \"Platform\".",{"varName":"230"},{"range":"231","text":"227"},{"varName":"232"},{"range":"233","text":"227"},{"varName":"234"},{"range":"235","text":"227"},"Remove unused variable \"BottomTabInset\".",{"varName":"236"},{"range":"237","text":"227"},"Remove unused variable \"MaxContentWidth\".",{"varName":"238"},{"range":"239","text":"227"},{"varName":"240"},{"range":"241","text":"227"},{"varName":"242"},{"range":"243","text":"227"},{"varName":"244"},{"range":"245","text":"227"},"Remove unused variable \"StatusBar\".",{"varName":"246"},{"range":"247